#!/bin/bash
set -u
export PATH=/usr/bin:/bin:/usr/sbin:/sbin
umask 077

fail() {
    printf '%s\n' "$1" >&2
    exit 1
}

(( EUID >= 501 && UID >= 501 )) || fail STP_E_USER
[[ $# == 2 ]] || fail STP_E_ARGUMENTS
temp_root=$(/usr/bin/getconf DARWIN_USER_TEMP_DIR 2>/dev/null) || fail STP_E_USER_TEMP
[[ "$temp_root" == /* && -d "$temp_root" ]] || fail STP_E_USER_TEMP
temp_root=$(CDPATH='' cd -- "$temp_root" && pwd -P) || fail STP_E_USER_TEMP
[[ -O "$temp_root" ]] || fail STP_E_USER_TEMP

if [[ $1 == --cleanup ]]; then
    userdir=$2
    [[ "${userdir%/*}" == "$temp_root" && "${userdir##*/}" =~ ^SOFTTrackingGUI\.[a-zA-Z0-9]{8}$ ]] \
        || fail STP_E_USER_PATH
    [[ -d "$userdir" && ! -L "$userdir" && -O "$userdir" ]] || fail STP_E_USER_PATH
    /bin/rm -rf -- "$userdir" >/dev/null 2>&1 || fail STP_E_USER_CLEANUP
    exit 0
fi

source_app=$1
source_runner=$2
[[ -d "$source_app" && ! -L "$source_app" && -f "$source_runner" && ! -L "$source_runner" ]] \
    || fail STP_E_PAYLOAD
userdir=''
prepared=0
cleanup() {
    local status=$?
    trap - EXIT
    trap '' HUP INT TERM
    if [[ -n "$userdir" && "$prepared" == 0 ]]; then
        /bin/rm -rf -- "$userdir" >/dev/null 2>&1 \
            || { printf '%s\n' STP_E_USER_CLEANUP >&2; status=1; }
    fi
    exit "$status"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
userdir=$(/usr/bin/mktemp -d "$temp_root/SOFTTrackingGUI.XXXXXXXX" 2>/dev/null) || fail STP_E_TEMP
[[ -d "$userdir" && ! -L "$userdir" && -O "$userdir" ]] || fail STP_E_USER_PATH
copied_app="$userdir/SOFT-Tracking-Setup.app"
/usr/bin/ditto "$source_app" "$copied_app" >/dev/null 2>&1 || fail STP_E_COPY
for component in "$copied_app" "$copied_app/Contents" "$copied_app/Contents/MacOS"; do
    [[ -d "$component" && ! -L "$component" && -O "$component" ]] || fail STP_E_LAYOUT
done
executable="$copied_app/Contents/MacOS/SOFT-Tracking-Setup"
[[ -f "$executable" && -x "$executable" && ! -L "$executable" ]] || fail STP_E_LAYOUT
/usr/bin/codesign --verify --deep --strict "$copied_app" >/dev/null 2>&1 || fail STP_E_SIGNATURE
/usr/bin/xattr -dr -s com.apple.quarantine "$copied_app" >/dev/null 2>&1 || fail STP_E_QUARANTINE
/bin/cp "$source_runner" "$userdir/runner.sh" >/dev/null 2>&1 || fail STP_E_COPY
printf '%s\n' "$userdir" || fail STP_E_USER_PATH
prepared=1
