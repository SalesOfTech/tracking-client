{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "default_locale": "en",
  "version": "3.2.1.60000",
  "version_name": "3.2.1",
  "description": "__MSG_extensionDescription__",
  "key": "",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "scripting",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "incognito": "not_allowed",
  "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "SOFT Tracking"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "privacy.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
